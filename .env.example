# ---------------------------------------------------------------------------
# JoabStudios · Environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, Open Graph, emails)
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Public contact channels (leave empty to hide them in the UI)
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp in international format, digits only. Example: 573001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Social profiles are edited in code: lib/site-config.ts (socialProfiles)

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Salt for hashing visitor IPs used in form rate limiting (random 32+ chars)
LEAD_IP_SALT=

# Resend (lead notifications). The from address must use a verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL="JoabStudios <leads@tu-dominio.com>"
# One or more addresses, comma-separated
LEAD_NOTIFICATION_EMAIL=

# Google Analytics 4 (optional). Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
